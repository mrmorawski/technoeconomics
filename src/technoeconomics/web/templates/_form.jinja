{# The editable plant form: per component, an enable toggle plus its visible parameters,
   with secondary ("advanced") parameters tucked under a <details>. Rendered by preset.jinja
   and re-rendered by POST /industrial_heat/reset, which htmx swaps in place (outerHTML on
   #model-form). `components` is web.forms.plant_to_form(plant). #}
{% macro param_input(p) %}
    <label>
        {{ p.label }}
        <input type="number" name="{{ p.path }}" value="{{ p.value }}" step="any">
    </label>
{% endmacro %}
<form id="model-form"
      hx-post="{{ url_for('industrial_heat_init_solve') }}"
      hx-target="#run"
      hx-swap="innerHTML">
    <div class="grid">
        {% for component in components %}
            <fieldset {% if component.color %}style="border-inline-start: 4px solid {{ component.color }}; padding-inline-start: 1rem"{% endif %}>
                <legend {% if component.color %}style="color: {{ component.color }}"{% endif %}>{{ component.title }}</legend>
                <label>
                    <input type="checkbox"
                           name="{{ component.id }}.enabled"
                           {% if component.enabled %}checked{% endif %}>
                    Enabled
                </label>
                {% for p in component.params if not p.advanced %}{{ param_input(p) }}{% endfor %}
                {% set advanced = component.params | selectattr('advanced') | list %}
                {% if advanced %}
                    <details>
                        <summary>Advanced</summary>
                        {% for p in advanced %}{{ param_input(p) }}{% endfor %}
                    </details>
                {% endif %}
            </fieldset>
        {% endfor %}
    </div>
    <div class="actions">
        <button type="submit">Solve</button>
        <button type="button"
                class="secondary outline"
                onclick="clearResults()"
                hx-post="{{ url_for('industrial_heat_reset') }}"
                hx-target="#model-form"
                hx-swap="outerHTML">Reset</button>
        <button type="button"
                class="secondary outline"
                hx-post="{{ url_for('industrial_heat_share') }}"
                hx-include="#model-form"
                hx-target="#share-out"
                hx-swap="innerHTML">Share</button>
    </div>
    {# POST /share renders the copyable link here (web/templates/_share.jinja). #}
    <div id="share-out"></div>
</form>
