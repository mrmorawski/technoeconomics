{# TODO: get rid of css cdn #}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description"
              content="Simulate and optimise energy systems — see when renewables beat gas.">
        <meta name="keywords"
              content="technoeconomics, energy systems, renewables, optimisation, simulation">
        <title>
            {% block title %}
                technoeconomics.app
            {% endblock title %}
        </title>
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.min.css">
        <link rel="stylesheet" href="{{ url_for('static', path='app.css') }}">
        {# TODO: vendor these cdn scripts (htmx, echarts) #}
        <script src="https://unpkg.com/htmx.org@2.0.4"></script>
        <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
    </head>
    <body>
        <nav class="container">
            <ul>
                <li>
                    <a href="{{ url_for('home') }}">Home</a>
                </li>
                <li>
                    <a href="{{ url_for('industrial_heat') }}">Industrial heat</a>
                </li>
                <li>
                    <a href="{{ url_for('about') }}">About</a>
                </li>
                <li>
                    <a href="{{ url_for('docs') }}">Docs</a>
                </li>
            </ul>
        </nav>
        <main class="container">
            {% block content %}
            {% endblock content %}
        </main>
    </body>
</html>
