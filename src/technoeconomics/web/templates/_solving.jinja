{# Swapped into #run by POST /init_solve. On success it shows the run console and opens
   the SSE stream (connectStream is defined in static/solve.js); htmx executes the inline
   script after the swap. On error nothing is started. #}
{% if error %}
    <p role="alert">Could not start solve: {{ error }}</p>
{% else %}
    <article class="run">
        <header>
            Run log
        </header>
        <pre id="console" class="console"></pre>
    </article>
    <script>connectStream();</script>
{% endif %}
