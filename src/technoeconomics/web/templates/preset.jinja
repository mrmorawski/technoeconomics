{% extends "base.jinja" %}
{% block title %}
    {{ title }} — technoeconomics.app
{% endblock title %}
{% block content %}
    <section>
        <h1>{{ title }}</h1>
        <p>{{ description }}</p>
        <figure class="schematic">
            {# Schematic SVG is inlined from the preset (backend/preset/schematics). #}
            {{ schematic | safe }}
        </figure>
        {# Form fields are generated from the plant — see web/forms.plant_to_form.
           Submitting records the edits and swaps in _solving.jinja, which opens the
           SSE stream; results below are then updated in place by solve.js. #}
        <form hx-post="{{ url_for('industrial_heat_init_solve') }}"
              hx-target="#run"
              hx-swap="innerHTML">
            <div class="grid">
                {% for component in components %}
                    <fieldset {% if component.color %}style="border-inline-start: 4px solid {{ component.color }}; padding-inline-start: 1rem"{% endif %}>
                        <legend {% if component.color %}style="color: {{ component.color }}"{% endif %}>{{ component.title }}</legend>
                        <label>
                            <input type="checkbox"
                                   name="{{ component.id }}.enabled"
                                   {% if component.enabled %}checked{% endif %}>
                            Enabled
                        </label>
                        {% for field in component.fields %}
                            <label>
                                {{ field.label }}
                                <input type="number"
                                       name="{{ field.name }}"
                                       value="{{ field.value }}"
                                       step="any">
                            </label>
                        {% endfor %}
                    </fieldset>
                {% endfor %}
            </div>
            <button type="submit">Solve</button>
        </form>
        {# Swapped by the POST: the run console, which opens the SSE stream. #}
        <div id="run"></div>
        {# Updated in place by solve.js as stream events arrive. #}
        <div id="numbers" class="numbers"></div>
        <div id="charts"></div>
    </section>
    <script src="{{ url_for('static', path='solve.js') }}"></script>
{% endblock content %}
