{% extends "base.jinja" %}
{% block title %}
    {{ title }} — technoeconomics.app
{% endblock title %}
{% block content %}
    <section>
        <h1>{{ title }}</h1>
        <p>{{ description }}</p>
        <figure class="schematic">
            {# Schematic SVG is inlined from the preset (backend/preset/schematics). #}
            {{ schematic | safe }}
        </figure>
        {# The editable plant form (web/forms.plant_to_form). Submitting records the edits and
           launches the solve; results below fill in via solve.js as the run streams in. #}
        {% include "_form.jinja" %}
        {# Filled in place by solve.js as the run streams over the EventSource (opened on load
           below): progress lines into the console, then the numbers and charts. #}
        <pre id="console" class="console"></pre>
        <div id="numbers" class="numbers"></div>
        <div id="charts"></div>
    </section>
    <script src="{{ url_for('static', path='solve.js') }}"></script>
    <script>connectStream();</script>
{% endblock content %}
