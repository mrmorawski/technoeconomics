{% extends "base.jinja" %}
{% block title %}
    {{ title }} — technoeconomics.app
{% endblock title %}
{% block content %}
    <section>
        <h1>{{ title }}</h1>
        <p>{{ description }}</p>
        <figure class="schematic">
            {# Schematic SVG is inlined from the preset (backend/preset/schematics). #}
            {{ schematic | safe }}
        </figure>
        {# The editable plant form (web/forms.plant_to_form). Submitting records the edits and
           swaps in _solving.jinja, which opens the SSE stream; results below update in place
           via solve.js. #}
        {% include "_form.jinja" %}
        {# Swapped by the POST: the run console, which opens the SSE stream. #}
        <div id="run"></div>
        {# Updated in place by solve.js as stream events arrive. #}
        <div id="numbers" class="numbers"></div>
        <div id="charts"></div>
    </section>
    <script src="{{ url_for('static', path='solve.js') }}"></script>
{% endblock content %}
