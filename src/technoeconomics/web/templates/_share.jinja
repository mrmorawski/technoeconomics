{# Result of POST /industrial_heat/share, swapped into #share-out: a copyable link to the
   current plant, or an error. Clicking the field selects its text for an easy copy. #}
{% if error %}
    <p role="alert">Could not build share link: {{ error }}</p>
{% else %}
    <label>
        Share link
        <input type="text" readonly value="{{ url }}" onclick="this.select()">
    </label>
{% endif %}
